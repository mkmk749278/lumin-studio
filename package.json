{
  "name": "lumin-studio",
  "private": true,
  "description": "Lumin Studio: programmatic quant-desk video for the Lumin: Crypto Signals channel",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio src/index.ts",
